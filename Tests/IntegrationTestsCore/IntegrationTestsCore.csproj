<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>

		<IsPackable>false</IsPackable>

		<ApplicationIcon />

		<OutputType>Library</OutputType>

		<StartupObject />

		<Version>2.0.0</Version>

		<AnalysisLevel>none</AnalysisLevel>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Fonlow.Testing.Integration" Version="1.2.8" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit.v3" Version="4.0.0-pre.154" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\DemoCoreWeb.ClientApi\DemoCoreWeb.ClientApi.csproj" />
		<ProjectReference Include="..\..\Fonlow.DateOnlyExtensions\Fonlow.DateOnlyExtensions.csproj" />
	</ItemGroup>

	<Import Project="..\IntegrationTestShared\IntegrationTestShared.projitems" Label="Shared" />

</Project>
